; ============================================================================
;  Pilote PCM — LECTURE DIRECTE DANS LA CARTOUCHE.
;
;  ⚠️ LE Z80 LIT LA ROM. C'est ainsi que font tous les jeux Mega Drive, et
;  c'est pour ca qu'on y entend des echantillons d'une seconde entiere sans
;  hoquet. On avait conclu l'inverse — « le Z80 n'obtient pas les donnees de
;  la cartouche » — et cette conclusion etait FAUSSE : le registre de banque
;  en 0x6000 est un REGISTRE A DECALAGE. Il prend NEUF ECRITURES, un bit
;  chacune, du plus faible au plus fort. Ecrit comme un octet ordinaire il ne
;  retient qu'un bit, la fenetre pointe n'importe ou, et les donnees reviennent
;  fausses — exactement le symptome releve.
;
;  Verifie sur la console : Z80 LIT ROM 7F 80 80, ATTENDU 7F 80 80.
;
;  Consequence : plus d'anneau, plus de recopie, plus de longueur maximale.
;  Chaque octet recopie dans la RAM du Z80 etait du son qui ne sortait pas —
;  ecrire cette RAM ARRETE le Z80. Ici le 68000 ne touche plus a rien pendant
;  la lecture.
;
;  Bloc de commande, en RAM Z80 :
;     0x0400  commande   0 = arret ; toute autre valeur = joue.
;     0x0402  pointeur   adresse dans la fenetre 0x8000-0xFFFF
;     0x0404  sorties    16 bits bas, decomptees une par sortie
;     0x0411  sorties    8 bits hauts
;     0x0412  banque     les neuf bits a poser en 0x6000
;     0x0408 fin hl  0x040A reste  0x040C finis  0x040D commences
;     0x040E dernier octet lu   0x040F premier octet lu
;
;  La table de gain vit en 0x0500, alignee sur une page : c'est elle qui donne
;  son volume a l'echantillon, un octet transforme par sortie.
; ============================================================================
        di
        ld sp, 0x0800
        exx
        ld hl, 0x0500           ; le jeu alternatif garde la table de gain
        exx

; ── CONTROLE PERMANENT : le Z80 atteint-il la cartouche ? ────────────────
; Trois octets lus au demarrage, que le 68000 relit et compare a ce qu'il sait
; devoir s'y trouver. Le journal l'ecrit a chaque allumage. Ca ne coute rien,
; et ca evite de rebatir un jour toute une architecture sur une mesure fausse.
        call pose_banque
        ld a, (0x8000)
        ld (0x0420), a
        ld a, (0x8001)
        ld (0x0421), a
        ld a, (0x8002)
        ld (0x0422), a

attente:
        ld a, (0x0400)
        or a
        jr z, attente
        ld c, a                 ; la commande en cours

        call pose_banque

        ld hl, (0x0402)
        ld a, (0x0404)
        ld e, a
        ld a, (0x0405)
        ld d, a
        ld b, 0                 ; l'accumulateur de fraction

        ld a, (hl)
        ld (0x040F), a
        ld a, (0x040D)
        inc a
        ld (0x040D), a

        ; On verrouille le convertisseur UNE FOIS : reselectionner le registre
        ; a chaque octet doublait le trafic vers la puce, qui en perdait.
        ld a, 0x2A
        ld (0x4000), a

boucle:
        ; L'octet brut, puis son volume par la table. Le jeu alternatif tient
        ; l'adresse de la table : `exx` coute quatre cycles, une indirection
        ; par registre d'index en couterait le triple.
        ld a, (hl)
        exx
        ld l, a
        ld a, (hl)
        exx
        ld (0x4001), a

        ; ── Avancer dans l'echantillon ───────────────────────────────────
        ; Une addition avec retenue : la partie entiere est un octet plein,
        ; donc aucune limite de transposition vers l'aigu.
        ld a, b
patch_frac:
        add a, 0
        ld b, a
        ld a, l
patch_ent:
        adc a, 0
        ld l, a
        jr nc, sans_report
        inc h
        ; h vient de repasser a zero : on a franchi le haut de la fenetre.
        ; ⚠️ C'est ici que se joue la lecture d'un echantillon long : on avance
        ; d'une banque et on repart en 0x8000. Une fois tous les 32 Ko, soit
        ; toutes les 1,3 seconde de son.
        jr nz, sans_report
        call banque_suivante
sans_report:

        ; UNE SEULE decrementation par sortie : `de` compte les SORTIES.
        dec de

        ld a, (0x0400)
        cp c
        jr nz, attente

        ld a, d
        or a
        jr nz, boucle
        ld a, e
        or a
        jr nz, boucle

        ; Le compteur a vingt-quatre bits : son octet haut ne se regarde qu'au
        ; passage du zero, une fois toutes les 65 536 sorties.
        ld a, (0x0411)
        or a
        jr z, vraiment_fini
        dec a
        ld (0x0411), a
        jp boucle
vraiment_fini:

        ; Ou en est-on ? On le note AVANT de toucher a A.
        dec hl
        ld a, (hl)
        ld (0x040E), a
        inc hl
        ld (0x0408), hl
        ld a, e
        ld (0x040A), a
        ld a, d
        ld (0x040B), a
        ld a, (0x040C)
        inc a
        ld (0x040C), a

        ; Fini : on se tait au milieu d'echelle, sinon la voie garde le dernier
        ; octet et laisse une composante continue audible.
        ld a, 0x2A
        ld (0x4000), a
        ld a, 0x80
        ld (0x4001), a

        ; ⚠️ ON N'EFFACE PAS LA COMMANDE : si le 68000 en a pose une pendant
        ; qu'on etait arrete, l'ecraser perdrait la note. On attend qu'elle
        ; CHANGE — c'est le seul evenement qui compte.
fini:
        ld a, (0x0400)
        cp c
        jr z, fini
        jp attente

; ── Poser la banque courante ─────────────────────────────────────────────
; Neuf ecritures, un bit chacune, du plus faible au plus fort.
pose_banque:
        ld a, (0x0412)
        ld b, 9
pb_boucle:
        ld (0x6000), a
        srl a
        djnz pb_boucle
        ret

; ── Passer a la banque suivante, au vol ──────────────────────────────────
; `bc` porte la fraction et la commande : on les met a l'abri.
banque_suivante:
        push bc
        ld a, (0x0412)
        inc a
        ld (0x0412), a
        call pose_banque
        pop bc
        ld h, 0x80
        ret
